TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Twilio number for making outbound and receiving inbound calls
# Purchase a Twilio phone number in the console
# https://www.twilio.com/console/phone-numbers/search
TWILIO_CALLER_ID=+1XXXYYYZZZZ

# SID of your TwiML Application
# Create a new TwiML app in the console
# https://www.twilio.com/console/voice/twiml/apps
TWILIO_TWIML_APP_SID=APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your REST API Key information
# Create a new key in the console (the TWILIO_API_KEY will be the SID shown starting with 'SK')
# https://www.twilio.com/console/project/api-keys
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=XXXXXXXXXXXXXXXXX

# Browser login: username is operator. Use a long random password.
APP_PASSWORD=
# Exact public origin used by Twilio to validate signed webhooks.
TWILIO_WEBHOOK_BASE_URL=https://twilio.iron-wing-dispatching.com
# Set to true only after verifying signed call callbacks in the deployed app.
TWILIO_CALL_WEBHOOKS_VERIFIED=false

# Required to save workspace Twilio connections (credentials are encrypted with
# it; saving is refused while it is unset). Generate a unique 32-byte key with
# `openssl rand -base64 32` and store it outside the database. Losing the key
# makes saved credentials unrecoverable.
WORKSPACE_CREDENTIALS_KEY=
# Optional development frontend origin for settings writes, e.g. http://localhost:5173.
# APP_ORIGIN=

# Optional: comma-separated former Twilio numbers to include in conversation history.
TWILIO_PREVIOUS_NUMBERS=

# --- AI receptionist (see README "AI receptionist") ---
# The agent answers inbound calls only when this is exactly "true".
RECEPTIONIST_ENABLED=
# Test mode is ON unless this is exactly "false". While it is on, the agent
# answers only the numbers listed in RECEPTIONIST_TEST_CALLERS.
RECEPTIONIST_TEST_MODE=
# Comma-separated E.164 numbers that always reach the agent, e.g. +15551230001
RECEPTIONIST_TEST_CALLERS=
# Calling hours (24h clock, end is exclusive) and their time zone.
RECEPTIONIST_HOURS_START=7
RECEPTIONIST_HOURS_END=18
RECEPTIONIST_HOURS_TZ=America/New_York
# ElevenLabs voice for the agent, in Twilio ConversationRelay's voice format.
RECEPTIONIST_VOICE=7EzWGsX10sAS4c9m9cPf
# Optional voice for the recorded fallback announcements. Leave empty to keep
# today's voice. Suggested: Polly.Joanna-Neural - confirm it against Twilio's
# <Say> voice list and on a test call before setting it.
RECEPTIONIST_SAY_VOICE=
# Claude models. Thinking: default|off. Speed: standard|fast (Opus only).
RECEPTIONIST_LIVE_MODEL=claude-opus-5-5
RECEPTIONIST_LIVE_EFFORT=low
RECEPTIONIST_LIVE_THINKING=default
RECEPTIONIST_LIVE_SPEED=standard
RECEPTIONIST_SUMMARY_MODEL=claude-opus-5-5
# Agent calls allowed per caller number per 24 hours, and the longest call.
RECEPTIONIST_DAILY_LIMIT=3
RECEPTIONIST_MAX_CALL_SECONDS=480
# Twilio's list price per ConversationRelay minute, in US dollars. Used only to
# estimate the cost shown in the call history.
RECEPTIONIST_RELAY_RATE=0.07
# Where lead emails go, and the SMTP account that sends them.
RECEPTIONIST_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Anthropic API key, read by the Anthropic SDK.
ANTHROPIC_API_KEY=

# --- Outreach intake (Jack's leads to Outreach, contract jack.call.v1) ---
# The sender runs only when this is exactly "1" and the four values below are
# all set. Leads are queued in outreach_outbox either way.
OUTREACH_INTAKE_ENABLED=
# Outreach's intake endpoint, e.g. https://<outreach>/internal/sales/intake/jack
OUTREACH_INTAKE_URL=
# Bearer token and HMAC signing secret shared with Outreach.
OUTREACH_INTAKE_TOKEN=
OUTREACH_INTAKE_SIGNING_SECRET=
# The workspace (uuid) whose receptionist leads go to Outreach. Required:
# with it unset no lead is queued or sent. Calls of other workspaces never are.
OUTREACH_INTAKE_WORKSPACE_ID=
